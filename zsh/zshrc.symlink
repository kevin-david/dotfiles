# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/dev

# The block below is checked in on purpose, and its position matters.
#
# ~/.zshrc is a symlink to this file, and Codex's installer appends a PATH block
# to ~/.zshrc on every install or update (on Linux with zsh, `pick_profile`
# resolves to ~/.zshrc). Deleting it is what makes it come back: the installer
# skips writing only when its markers are already present with a matching
# export line. So it lives here instead of being removed every update.
#
# Keep it ABOVE the loops below, not appended at the end where the installer
# puts it. system/_path.zsh prepends ~/.local/bin too, and then prepends the
# Codex managed-install bin dir ahead of it; if this block ran last it would
# push ~/.local/bin back in front, and the shared ~/.local/bin/codex shim is
# rewritten by whichever host updated last, so it frequently dangles.
#
# The line itself is redundant — system/_path.zsh:1 already adds this directory.
# Do not add commentary between the markers: the installer rewrites that span.
# >>> Codex installer >>>
export PATH="/home/kevin/.local/bin:$PATH"
# <<< Codex installer <<<

# Stash your environment variables in ~/.localrc. This means they'll stay out
# of your main dotfiles repository (which may be public, like this one), but
# you'll have access to them in your scripts.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files
