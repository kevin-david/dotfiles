#!/bin/bash
#
# hogs [N] [--by-env] [--mem]
#
# One-shot "why is this box unhappy" triage for a Linux/Proxmox host.
#
#   default : verdict + load-decomposition header + crash-loops + top-N by CPU
#             + top-N by disk I/O + per-device saturation + ZFS attribution
#   --by-env: cores-per-cgroup rollup (which env/container is eating the box)
#   --mem   : top-N by RSS + swap + memory pressure (ZFS ARC shown separately)
#
# Notes:
#   - %CPU is a LIVE sample (two top readings), not ps's misleading lifetime avg.
#   - The header separates the failure modes we actually hit: CPU-bound (high r,
#     us/sy) vs I/O-stall (high b, wa) vs scheduler thrash (ctxsw) vs fork/zombie
#     leaks. Per-process tells you "what", --by-env tells you "where".
#   - PSI "full" is the honest pain number: it means EVERY task was stalled.
#     "some" only means at least one was. full>10% on io is a real emergency.
#   - On ZFS, per-process I/O lies: the kernel does the work in txg_sync and
#     prefetch threads, and ARC hits never touch a device at all. That is what
#     the DEVICE and ZFS sections are for -- trust them over the per-process
#     table when the two disagree.
#   - Owner is from /proc/<pid>/cgroup; docker IDs resolve to names best-effort
#     from the host daemon + each LXC's nested docker.
#   - Run as root for full visibility (all users, I/O accounting, nested docker,
#     restart counts).
#
# Usage:  hogs · hogs 30 · sudo hogs --by-env · sudo hogs --mem

# Re-exec as root via our absolute path. `sudo hogs` fails because sudo's
# secure_path doesn't include ~/.dotfiles/bin — but `hogs` is on the user's
# PATH, so let it find us, then elevate itself. (Skip if already root, or if
# there's no sudo / no tty to prompt on.)
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && [ -t 0 ]; then
  exec sudo "$0" "$@"
fi

N=20; BY_ENV=0; MEM=0
for a in "$@"; do
  case "$a" in
    --by-env) BY_ENV=1 ;;
    --mem)    MEM=1 ;;
    *[!0-9]*|'') : ;;
    *) N="$a" ;;
  esac
done

LXC_DOCKER=/run/current-system/sw/bin/docker   # nested docker path inside NixOS LXCs

# ---------------- t=0 counter snapshot (deltas computed at the end) ----------
# Taken first so the DEVICE/ZFS sections measure the whole script runtime for
# free, instead of paying for another sleep.
SNAP=$(mktemp -d); trap 'rm -rf "$SNAP" "$FLAP" "$FLAP2"' EXIT
T0=$(date +%s%N)
cp /proc/diskstats "$SNAP/disk0" 2>/dev/null
zfs_objsets() {   # emits: pool/dataset reads writes nread nwritten
  local f n
  for f in /proc/spl/kstat/zfs/*/objset-0x*; do
    [ -r "$f" ] || continue
    n=$(awk '/^dataset_name/{print $3}' "$f" 2>/dev/null) || continue
    [ -n "$n" ] && awk -v n="$n" '
      /^reads /{r=$3} /^writes /{w=$3} /^nread /{nr=$3} /^nwritten /{nw=$3}
      END{if(r!=""||w!="") print n, r+0, w+0, nr+0, nw+0}' "$f"
  done
}
zfs_objsets > "$SNAP/zfs0" 2>/dev/null
awk '/^hits /{h=$3} /^misses /{m=$3} END{print h+0, m+0}' \
  /proc/spl/kstat/zfs/arcstats > "$SNAP/arc0" 2>/dev/null

# ---------------- container map (id->name) + flapping list ----------------
declare -A NAME
FLAP=$(mktemp); FLAP2=$(mktemp)

scan_env() {            # $1=env label ("" for host); reads docker inspect lines on stdin
  local env="$1" id nm rc st started sid
  while IFS='|' read -r id nm rc st started; do
    [ -z "$id" ] && continue
    nm=${nm#/}; sid=${id:0:12}
    NAME[$sid]="${env:+$env:}$nm"
    if [ "${rc:-0}" -ge 5 ] 2>/dev/null || [ "$st" = "restarting" ]; then
      printf '%s\t%s\t%s\t%s\t%s\n' "${env:-host}" "$nm" "$rc" "$st" "$started" >>"$FLAP"
    fi
  done
}
inspect_all() {         # $@ = docker invocation; emits id|name|restartcount|status
  local ids; ids=$("$@" ps -aq 2>/dev/null) || return 0
  [ -n "$ids" ] && "$@" inspect --format '{{.Id}}|{{.Name}}|{{.RestartCount}}|{{.State.Status}}|{{.State.StartedAt}}' $ids 2>/dev/null
}
if command -v docker >/dev/null 2>&1; then
  scan_env "" < <(inspect_all docker)
fi
if command -v pct >/dev/null 2>&1; then
  for ct in $(pct list 2>/dev/null | awk 'NR>1{print $1}'); do
    scan_env "lxc$ct" < <(inspect_all pct exec "$ct" -- "$LXC_DOCKER")
  done
fi

owner() {               # $1=pid -> container-name | lxc:N | vm:N | docker:<id> | host
  local cg lxc did vm
  case "$1" in ''|*[!0-9]*) printf '?'; return ;; esac   # guard: only real pids
  cg=$(tr '\0\n' '  ' < "/proc/$1/cgroup" 2>/dev/null) || { printf '?'; return; }
  lxc=$(printf '%s' "$cg" | grep -oE '/lxc/[0-9]+' | head -1 | grep -oE '[0-9]+$')
  did=$(printf '%s' "$cg" | grep -oE 'docker-[0-9a-f]{12}' | head -1 | sed 's/docker-//')
  vm=$(printf '%s' "$cg"  | grep -oE 'qemu\.slice/[0-9]+' | head -1 | grep -oE '[0-9]+$')
  if   [ -n "$did" ] && [ -n "${NAME[$did]}" ]; then printf '%s' "${NAME[$did]}"
  elif [ -n "$did" ]; then printf '%sdocker:%s' "${lxc:+lxc$lxc/}" "$did"
  elif [ -n "$lxc" ]; then printf 'lxc:%s' "$lxc"
  elif [ -n "$vm"  ]; then printf 'vm:%s' "$vm"
  else printf 'host'; fi
}
psi()      { awk -F'[= ]' '/some/{print $3; exit}' "/proc/pressure/$1" 2>/dev/null; }
psi_full() { awk -F'[= ]' '/full/{print $3; exit}' "/proc/pressure/$1" 2>/dev/null; }

# ----------------------------- header / triage -----------------------------
echo "=================== TRIAGE ==================="
echo "load: $(cut -d' ' -f1-3 /proc/loadavg)   cores: $(nproc)"
set -- $(vmstat 1 2 2>/dev/null | tail -1)   # 1=r 2=b 11=in 12=cs 13=us 14=sy 15=id 16=wa
VM_R=${1:-0}; VM_B=${2:-0}; VM_ID=${15:-100}; VM_WA=${16:-0}; VM_CS=${12:-0}
if [ -n "${16:-}" ]; then
  echo "runnable r=$1  blocked(D) b=$2   cpu: us=${13}% sy=${14}% id=${15}% iowait=${16}%   ctxsw=${12}/s"
  echo "  -> high r + low idle = CPU-bound | high b + iowait = I/O-stall | huge ctxsw = thrash"
fi
PC=$(psi cpu); PI=$(psi io); PM=$(psi memory)
PIF=$(psi_full io); PMF=$(psi_full memory)
echo "PSI some/avg10:  cpu=${PC}%  io=${PI}%  mem=${PM}%"
echo "PSI full/avg10:            io=${PIF}%  mem=${PMF}%   <- 'full' = ALL tasks stalled"
# Memory in the default view: ARC is counted as "used" by free(1) but is
# reclaimable, so raw "used" is alarmist on a ZFS host. Show them separately.
ARCB=$(awk '/^size /{print $3}' /proc/spl/kstat/zfs/arcstats 2>/dev/null)
MEMLINE=$(awk -v arc="${ARCB:-0}" '
  /^MemTotal:/{t=$2} /^MemAvailable:/{a=$2}
  /^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2}
  END{
    printf "mem: %.0fG total, %.0fG available (%.0f%%)", t/1048576, a/1048576, a*100/t
    if (arc>0) printf "  |  ZFS ARC %.1fG (reclaimable)", arc/1073741824
    if (st>0)  printf "  |  swap %.1fG/%.1fG used", (st-sf)/1048576, st/1048576
    else       printf "  |  swap off"
  }' /proc/meminfo)
echo "$MEMLINE"
MEM_AVAIL_PCT=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{printf "%d", a*100/t}' /proc/meminfo)
SWAP_USED=$(awk '/^SwapTotal:/{st=$2} /^SwapFree:/{sf=$2} END{print st-sf}' /proc/meminfo)
Z=$(ps -eo stat= 2>/dev/null | grep -c '^Z')
if [ "$Z" -gt 0 ]; then
  zp=$(ps -eo stat=,ppid= | awk '$1 ~ /^Z/{print $2}' | sort | uniq -c | sort -rn | head -1)
  zppid=$(echo "$zp" | awk '{print $2}')
  echo "zombies: $Z   top reaper-gap parent: $(echo "$zp" | awk '{print $1}')x under pid $zppid [$(owner "$zppid") $(ps -o comm= -p "$zppid" 2>/dev/null)]"
fi

# ----------------------------- flapping/crash-loops -----------------------------
# RESTARTS is a LIFETIME counter -- on a host up for weeks it says nothing about
# now. What separates a fire from history is CURRENT uptime: a container running
# 8h with 38 restarts is stable; one running 40s with 6 is looping.
LOOP_MAX_UP=600                       # running & younger than this = still looping
if [ -s "$FLAP" ]; then
  NOW=$(date +%s)
  while IFS=$'\t' read -r env nm rc st started; do
    ups=-1
    case "$started" in
      ''|0001-01-01*) ;;
      *) s=$(date -d "$started" +%s 2>/dev/null) && ups=$(( NOW - s )) ;;
    esac
    if   [ "$ups" -lt 0 ];      then up='?'
    elif [ "$ups" -lt 3600 ];   then up="$((ups/60))m"
    elif [ "$ups" -lt 172800 ]; then up="$((ups/3600))h"
    else                             up="$((ups/86400))d"; fi
    case "$st" in
      restarting) live=0 ;;
      running)    if [ "$ups" -ge 0 ] && [ "$ups" -lt "$LOOP_MAX_UP" ]; then live=0; else live=1; fi ;;
      *)          live=2 ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$live" "$env" "$nm" "$rc" "$st" "$up"
  done <"$FLAP" >"$FLAP2"

  if awk -F'\t' '$1==0{f=1} END{exit !f}' "$FLAP2"; then hdr="CRASH-LOOP / FLAPPING"; else hdr="RESTART HISTORY (nothing looping now)"; fi
  echo
  echo "=================== $hdr  (restarts>=5 or restarting) ==================="
  printf "%-10s %-30s %10s  %-12s %-6s %s\n" "ENV" "CONTAINER" "RESTARTS" "STATE" "UPFOR" ""
  sort -t$'\t' -k1,1n -k4,4rn "$FLAP2" | head -n "$N" \
    | while IFS=$'\t' read -r live env nm rc st up; do
        case "$live" in
          0) note='<- LIVE (looping now)' ;;
          1) note='   stable' ;;
          *) note='' ;;
        esac
        printf "%-10s %-30s %10s  %-12s %-6s %s\n" "$env" "$nm" "$rc" "$st" "$up" "$note"
      done
  echo "  -> RESTARTS is lifetime; UPFOR is what matters. 'stable' = high count, but"
  echo "     running longer than ${LOOP_MAX_UP}s, so the restarts are old history."
fi

# ----------------------------- top by CPU -----------------------------
echo
echo "=================== TOP $N BY CPU  (live sample) ==================="
printf "%-26s %6s %8s  %s\n" "OWNER" "%CPU" "PID" "COMMAND"
TOPCPU=""
while read -r pid _ _ _ _ _ _ _ cpu _ _ cmd; do
  own=$(owner "$pid")
  [ -z "$TOPCPU" ] && TOPCPU="$own ${cpu}%"
  printf "%-26s %6s %8s  %.100s\n" "$own" "$cpu" "$pid" "$cmd"
done < <(top -bc -w 512 -o %CPU -n 2 -d 1 \
  | awk '/^top - /{it++} it==2' \
  | awk 'h{print} /^[[:space:]]*PID[[:space:]]+USER/{h=1}' \
  | head -n "$N")

# ----------------------------- top by I/O -----------------------------
# Sorted by read+write. Sorting by writes alone hides read storms, which is the
# shape a cache-miss / scan problem actually takes.
echo
echo "=================== TOP $N BY DISK I/O  (kB/s, sorted by rd+wr) ==================="
if command -v iotop >/dev/null 2>&1; then
  printf "%-26s %9s %9s %8s  %s\n" "OWNER" "READ_K/s" "WRITE_K/s" "PID" "COMMAND"
  iotop -boPk -qqq -n 2 -d 1 \
    | awk '$1 ~ /^[0-9]+$/ {c=""; for(i=12;i<=NF;i++) c=c (i>12?" ":"") $i;
           printf "%.2f\t%s\t%s\t%s\t%s\n", $4+$6, $1, $4, $6, c}' \
    | sort -t$'\t' -k1,1rn | awk -F'\t' '!seen[$2]++' | head -n "$N" \
    | while IFS=$'\t' read -r _ pid rd wr cmd; do
        printf "%-26s %9s %9s %8s  %.100s\n" "$(owner "$pid")" "$rd" "$wr" "$pid" "$cmd"
      done
elif command -v pidstat >/dev/null 2>&1; then
  printf "%-26s %9s %9s %8s  %s\n" "OWNER" "kB_rd/s" "kB_wr/s" "PID" "COMMAND"
  # S_TIME_FORMAT=ISO keeps the timestamp a single field; a locale that renders
  # "11:37:12 PM" shifts every column and silently corrupts this table.
  S_TIME_FORMAT=ISO LC_ALL=C pidstat -dl 1 1 2>/dev/null \
    | awk '$3 ~ /^[0-9]+$/ && $0 !~ /Average:/ {c=""; for(i=8;i<=NF;i++) c=c (i>8?" ":"") $i;
           printf "%.2f\t%s\t%s\t%s\t%s\n", $4+$5, $3, $4, $5, c}' \
    | sort -t$'\t' -k1,1rn | awk -F'\t' '!seen[$2]++' | head -n "$N" \
    | while IFS=$'\t' read -r _ pid rd wr cmd; do
        printf "%-26s %9s %9s %8s  %.100s\n" "$(owner "$pid")" "$rd" "$wr" "$pid" "$cmd"
      done
else
  echo "(install iotop or sysstat for per-process I/O: apt install iotop sysstat)"
fi
echo "  -> on ZFS these numbers UNDERCOUNT badly: kernel txg_sync/prefetch does"
echo "     the real work and ARC hits never reach a device. Cross-check below."

# ----------------------------- per-device saturation -----------------------------
# From /proc/diskstats deltas over the whole script runtime. No iostat needed.
ELAPSED_MS=$(( ($(date +%s%N) - T0) / 1000000 ))
[ "$ELAPSED_MS" -lt 1 ] && ELAPSED_MS=1
if [ -r "$SNAP/disk0" ]; then
  echo
  echo "=================== DEVICE SATURATION  (${ELAPSED_MS}ms window) ==================="
  DEVOUT=$(join -j 3 -o 0,1.4,1.6,1.8,1.10,1.7,1.11,1.13,1.14,2.4,2.6,2.8,2.10,2.7,2.11,2.13,2.14 \
      <(sort -k3,3 "$SNAP/disk0") <(sort -k3,3 /proc/diskstats) 2>/dev/null \
    | awk -v ms="$ELAPSED_MS" '
      # skip partitions and pseudo devices
      $1 ~ /^(loop|ram)/ {next}
      $1 ~ /^(sd[a-z]+|vd[a-z]+|hd[a-z]+)[0-9]+$/ {next}
      $1 ~ /^nvme[0-9]+n[0-9]+p[0-9]+$/ {next}
      $1 ~ /^zd[0-9]+p[0-9]+$/ {next}
      {
        s=ms/1000
        dr=$10-$2; dw=$12-$4; drs=$11-$3; dws=$13-$5
        dmr=$14-$6; dmw=$15-$7; dio=$16-$8; dwt=$17-$9
        util=dio*100/ms; if(util>100) util=100
        if (util < 1 && dr+dw < 1) next
        printf "%-10s %7.1f %9.1f %9.1f %9.2f %9.2f %8.2f %7.1f\n", $1,
          util, dr/s, dw/s, drs*512/1048576/s, dws*512/1048576/s,
          (dr>0?dmr/dr:0), dwt/ms
      }' | sort -k2 -rn)
  if [ -n "$DEVOUT" ]; then
    printf "%-10s %7s %9s %9s %9s %9s %8s %7s\n" DEVICE %UTIL r/s w/s readMB/s writeMB/s r_await aqu-sz
    echo "$DEVOUT" | head -n "$N"
    echo "  -> %util near 100 = device always busy. On a spinning disk, r_await"
    echo "     over ~20ms with small r/s means random-seek thrash, not throughput."
  else
    echo "(no device activity in window)"
  fi
fi

# ----------------------------- ZFS attribution -----------------------------
if [ -s "$SNAP/zfs0" ]; then
  echo
  echo "=================== ZFS PER-DATASET I/O  (${ELAPSED_MS}ms window) ==================="
  ZOUT=$(zfs_objsets 2>/dev/null | sort -k1,1 \
    | join -j 1 -o 0,1.2,1.3,1.4,1.5,2.2,2.3,2.4,2.5 <(sort -k1,1 "$SNAP/zfs0") - 2>/dev/null \
    | awk -v ms="$ELAPSED_MS" '{s=ms/1000;
        r=($6-$2)/s; w=($7-$3)/s; rk=($8-$4)/1048576/s; wk=($9-$5)/1048576/s;
        if (r>1||w>1||rk>0.5||wk>0.5) printf "%-38s %9.1f %9.1f %10.2f %10.2f\n",$1,r,w,rk,wk}' \
    | sort -k2 -rn)
  if [ -n "$ZOUT" ]; then
    printf "%-38s %9s %9s %10s %10s\n" DATASET rd/s wr/s readMB/s writeMB/s
    echo "$ZOUT" | head -n "$N"
    echo "  -> this is LOGICAL I/O. Compare with DEVICE above: high here + low"
    echo "     there = served from ARC (fine). High in both = real disk pressure."
  fi
  # pools past the performance cliff
  if command -v zpool >/dev/null 2>&1; then
    POOLW=$(zpool list -H -o name,capacity,fragmentation 2>/dev/null \
      | awk '{gsub(/%/,"",$2); gsub(/%/,"",$3); if ($2+0 >= 80) printf "  %-18s %3d%% full, %s%% fragmented\n",$1,$2,$3}')
    if [ -n "$POOLW" ]; then
      echo
      echo "  ZFS pools past the 80% performance cliff:"
      echo "$POOLW"
      echo "  -> past ~80% ZFS switches to best-fit allocation; writes fragment and slow down"
    fi
  fi
  # ARC health
  if [ -r "$SNAP/arc0" ] && [ -r /proc/spl/kstat/zfs/arcstats ]; then
    read -r H0 M0 < "$SNAP/arc0"
    awk -v h0="$H0" -v m0="$M0" '
      /^size /{sz=$3} /^c /{c=$3} /^c_min/{cm=$3} /^hits /{h=$3} /^misses /{m=$3}
      END{
        dh=h-h0; dm=m-m0; hr=(dh+dm>0)? dh*100/(dh+dm) : 0
        printf "\n  ARC: %.2f GiB (target %.2f, floor %.2f)   hit rate this window: %.1f%%\n", \
          sz/2^30, c/2^30, cm/2^30, hr
        if (c <= cm*1.10) print "  -> target is pinned at the floor: ARC is being reclaimed, not sized to demand"
      }' /proc/spl/kstat/zfs/arcstats
  fi
fi

# ----------------------------- verdict -----------------------------
echo
echo "=================== VERDICT ==================="
V=""
awk -v pc="${PC:-0}" -v pif="${PIF:-0}" -v pi="${PI:-0}" -v pmf="${PMF:-0}" \
    -v id="${VM_ID:-100}" -v b="${VM_B:-0}" -v cs="${VM_CS:-0}" -v top="$TOPCPU" \
    -v avail="${MEM_AVAIL_PCT:-100}" -v swu="${SWAP_USED:-0}" '
BEGIN{
  n=0
  if (pmf+0 > 5)             { printf "  MEMORY STALL   PSI mem full=%s%% -- check ARC and swap first\n", pmf; n++ }
  if (avail+0 < 10)          { printf "  MEMORY TIGHT   only %s%% available -- ARC should shrink before this hurts\n", avail; n++ }
  if (swu+0 > 0)             { printf "  SWAP IN USE    %.1f GiB -- on this box swap is meant to be off\n", swu/1048576; n++ }
  if (pif+0 > 10)            { printf "  I/O STALL      PSI io full=%s%% -- every task is waiting on a device\n", pif; n++ }
  else if (pi+0 > 25)        { printf "  I/O PRESSURE   PSI io some=%s%% -- some tasks waiting; see DEVICE table\n", pi; n++ }
  if (pc+0 > 40 && id+0 < 15){ printf "  CPU-BOUND      PSI cpu some=%s%%, idle=%s%% -- top: %s\n", pc, id, top; n++ }
  else if (pc+0 > 40)        { printf "  CPU PRESSURE   PSI cpu some=%s%% -- top: %s\n", pc, top; n++ }
  if (cs+0 > 100000)         { printf "  SCHED THRASH   %s ctxsw/s\n", cs; n++ }
  if (n==0)                  { printf "  healthy        PSI cpu=%s%% io(full)=%s%% -- nothing saturated\n", pc, pif }
}'
echo "  (load average counts host + every LXC + every VM; it overstates host pain)"

# ----------------------------- --by-env rollup -----------------------------
if [ "$BY_ENV" = 1 ] && [ -d /sys/fs/cgroup ]; then
  echo
  echo "=================== CORES BY ENV/CONTAINER  (2s delta) ==================="
  cd /sys/fs/cgroup || exit
  # Only meaningful units (not nested parent aggregates): each LXC as a whole,
  # each host docker container, each VM scope. LXC-internal containers roll up
  # into their lxc:N total.
  mapfile -t CGS < <(
    ls -d lxc/[0-9]*/cpu.stat 2>/dev/null
    ls -d qemu.slice/*.scope/cpu.stat 2>/dev/null
    ls -d system.slice/docker-*.scope/cpu.stat 2>/dev/null
  )
  declare -A U1
  for f in "${CGS[@]}"; do U1["$f"]=$(awk '/^usage_usec/{print $2}' "$f" 2>/dev/null); done
  sleep 2
  for f in "${CGS[@]}"; do
    u2=$(awk '/^usage_usec/{print $2}' "$f" 2>/dev/null); [ -z "$u2" ] && continue
    d=$(( u2 - ${U1[$f]:-$u2} )); [ "$d" -gt 0 ] || continue
    case "$f" in
      lxc/*)                 lbl="lxc:$(printf '%s' "$f" | grep -oE 'lxc/[0-9]+' | grep -oE '[0-9]+$')" ;;
      qemu.slice/*)          lbl="vm:$(printf '%s' "$f" | grep -oE '[0-9]+\.scope' | grep -oE '[0-9]+')" ;;
      system.slice/docker-*) did=$(printf '%s' "$f" | grep -oE 'docker-[0-9a-f]{12}' | sed 's/docker-//'); lbl="${NAME[$did]:-docker:$did}" ;;
      *)                     lbl="$f" ;;
    esac
    printf '%d\t%s\n' "$d" "$lbl"
  done | sort -rn | head -n "$N" | awk -F'\t' '{printf "%6.2f cores  %s\n", $1/2000000, $2}'
fi

# ----------------------------- --mem section -----------------------------
if [ "$MEM" = 1 ]; then
  echo
  echo "=================== MEMORY ==================="
  free -h | awk 'NR<=2'
  echo "PSI mem some/avg10: $(psi memory)%   full/avg10: $(psi_full memory)%"
  [ -r /proc/spl/kstat/zfs/arcstats ] && \
    awk '/^size /{printf "ZFS ARC: %.1f GiB (counts as used, but reclaimable)\n",$3/1073741824}' /proc/spl/kstat/zfs/arcstats
  # Per-container rollup: the memory analogue of --by-env. RSS summed across
  # processes double-counts shared pages; cgroup memory.current does not.
  if [ -d /sys/fs/cgroup ]; then
    echo "-- memory by env/container (cgroup memory.current) --"
    printf "%-34s %10s %10s  %s\n" "OWNER" "USED_MB" "LIMIT_MB" "AT_LIMIT?"
    {
      for f in /sys/fs/cgroup/lxc/[0-9]*/memory.current \
               /sys/fs/cgroup/qemu.slice/*.scope/memory.current \
               /sys/fs/cgroup/system.slice/docker-*.scope/memory.current; do
        [ -r "$f" ] || continue
        d=$(dirname "$f"); cur=$(cat "$f" 2>/dev/null) || continue
        max=$(cat "$d/memory.max" 2>/dev/null)
        hi=$(awk '/^high /{print $2}' "$d/memory.events" 2>/dev/null)
        case "$f" in
          */lxc/*)               lbl="lxc:$(printf '%s' "$f" | grep -oE 'lxc/[0-9]+' | grep -oE '[0-9]+$')" ;;
          */qemu.slice/*)        lbl="vm:$(printf '%s' "$f" | grep -oE '[0-9]+\.scope' | grep -oE '[0-9]+')" ;;
          */docker-*)            did=$(printf '%s' "$f" | grep -oE 'docker-[0-9a-f]{12}' | sed 's/docker-//'); lbl="${NAME[$did]:-docker:$did}" ;;
          *)                     lbl="$f" ;;
        esac
        printf '%s\t%s\t%s\t%s\n' "$cur" "$lbl" "$max" "${hi:-0}"
      done
    } | sort -rn | head -n "$N" | awk -F'\t' '{
        lim = ($3=="max"||$3=="") ? "-" : sprintf("%.0f", $3/1048576)
        flag = ($4+0 > 0) ? sprintf("yes (%d high events)", $4) : ""
        printf "%-34s %10.0f %10s  %s\n", $2, $1/1048576, lim, flag
      }'
    echo "  -> AT_LIMIT means the cgroup has hit memory.high and is being"
    echo "     reclaimed. On ZFS that also evicts the HOST ARC (not cgroup-aware)."
  fi
  echo "-- top $N by RSS (double-counts shared pages; use the table above for totals) --"
  printf "%-26s %9s  %s\n" "OWNER" "RSS_MB" "COMMAND"
  ps -eo pid=,rss=,args= --sort=-rss | head -n "$N" | while read -r pid rss cmd; do
    printf "%-26s %9s  %.100s\n" "$(owner "$pid")" "$((rss/1024))" "$cmd"
  done
fi
