#!/usr/bin/env bash
# Launch Codex, picking up an account switch first.
#
# Codex's app-server daemon loads credentials once at startup and offers no way
# to re-read them. So switching accounts -- by hand, or by a background
# switcher like `codex-auth` -- changes the files on disk while a running daemon
# keeps serving the account it booted with. The switch looks like it worked and
# silently does nothing, including switching off an account that has run out of
# quota.
#
# There is no supported in-place fix. The app-server protocol's only route is
# `account/login/start` with `chatgptAuthTokens`, which is marked OpenAI-internal
# and unstable, stores tokens in memory only, and makes the caller responsible
# for token refresh. Restarting the daemon is the supported option.
#
# So detect the switch at launch, when a restart is cheapest: you are starting a
# session anyway, and recorded sessions survive it (`codex resume --last`).
#
# Keyed on the registry's active_account_key, deliberately:
#   - not auth.json's mtime, which also changes on every token refresh and would
#     restart the daemon constantly;
#   - not the ChatGPT account id, because several logins into one workspace share
#     it, so switching between them would go undetected.
#
# Set CODEX_NO_AUTO_RESTART=1 to report the stale daemon instead of restarting.
set -euo pipefail

# CODEX_HOME selects Codex's state -- auth.json, accounts/registry.json, the
# app-server socket -- and not its install. `codex-auth login` leans on exactly
# that split: it runs the login flow under a throwaway CODEX_HOME
# (~/.codex/accounts/login-<id>-0) so a failed attempt cannot corrupt the live
# auth.json, then deletes it. That scratch home has no install under it, so
# resolving the binary from CODEX_HOME killed every `codex-auth login` here with
# exit 127, before `codex login` ever ran.
#
# So the install root is fixed and only the state root follows CODEX_HOME.
# ~/.local/bin/codex still stays out of it: Codex rewrites that alias on every
# install or update as a path absolute under the CODEX_HOME that wrote it, so it
# dangles anywhere ~/.local is shared between machines. $HOME/.codex is relative
# to whichever machine is asking, so it resolves on all of them.
CODEX_BIN="$HOME/.codex/packages/standalone/current/bin/codex"

CODEX_ROOT="${CODEX_HOME:-$HOME/.codex}"
STAMP="$CODEX_ROOT/.active-account-stamp"

if [ ! -x "$CODEX_BIN" ]; then
  echo "codex: no managed install at $CODEX_BIN" >&2
  echo "codex: install it with: curl -fsSL https://chatgpt.com/codex/install.sh | sh" >&2
  exit 127
fi

# Read the selected account without needing a JSON parser on PATH.
active_account_key() {
  local registry="$CODEX_ROOT/accounts/registry.json"
  [ -f "$registry" ] || return 0
  sed -n 's/.*"active_account_key"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$registry" | head -1
}

# Only meaningful when a daemon is already running; there is nothing stale
# otherwise, and starting one here would be a surprise.
daemon_running() {
  [ -S "$CODEX_ROOT/app-server-control/app-server-control.sock" ]
}

daemon_lifecycle_command() {
  local arg
  if [ "${1:-}" = remote-control ]; then
    shift
    for arg in "$@"; do
      [ "$arg" = start ] || [ "$arg" = stop ] || continue
      return 0
    done
    return 1
  fi

  if [ "${1:-}" = app-server ] && [ "${2:-}" = daemon ]; then
    shift 2
    for arg in "$@"; do
      case "$arg" in
        bootstrap|start|restart|enable-remote-control|disable-remote-control|stop) return 0 ;;
      esac
    done
  fi
  return 1
}

pid_record_value() {
  local file="$1" field="$2"
  sed -n "s/.*\"$field\":[[:space:]]*\"\{0,1\}\([^\",}]*\).*/\1/p" "$file" | head -1
}

process_start_time() {
  ps -p "$1" -o lstart= 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

process_status_value() {
  sed -n "s/^$2:[[:space:]]*\([^[:space:]]*\).*/\1/p" "/proc/$1/status" 2>/dev/null
}

# Codex 0.153.2 can leave a stopped app-server as a zombie below the durable
# pid-update-loop. Its PID remains valid while its control socket is gone, so
# both daemon start and stop wait for state that cannot arrive. Stop only the
# recorded manager, and only after every local identity check matches.
recover_unreaped_daemon() {
  local daemon_pid_file="$CODEX_ROOT/app-server-daemon/app-server.pid"
  local updater_pid_file="$CODEX_ROOT/app-server-daemon/app-server-updater.pid"
  local socket="$CODEX_ROOT/app-server-control/app-server-control.sock"
  local daemon_pid updater_pid daemon_start updater_start
  local updater_exe
  local -a updater_argv=()

  [ ! -S "$socket" ] || return 0
  [ -r "$daemon_pid_file" ] && [ -r "$updater_pid_file" ] || return 0

  daemon_pid="$(pid_record_value "$daemon_pid_file" pid)"
  updater_pid="$(pid_record_value "$updater_pid_file" pid)"
  daemon_start="$(pid_record_value "$daemon_pid_file" processStartTime)"
  updater_start="$(pid_record_value "$updater_pid_file" processStartTime)"
  [[ "$daemon_pid" =~ ^[0-9]+$ ]] && [[ "$updater_pid" =~ ^[0-9]+$ ]] || return 0
  [ -r "/proc/$daemon_pid/status" ] && [ -r "/proc/$updater_pid/status" ] || return 0

  [ "$(process_status_value "$daemon_pid" State)" = Z ] || return 0
  [ "$(process_status_value "$daemon_pid" PPid)" = "$updater_pid" ] || return 0
  [ "$(process_status_value "$daemon_pid" Uid)" = "$(id -u)" ] || return 0
  [ "$(process_status_value "$updater_pid" Uid)" = "$(id -u)" ] || return 0
  [ "$(process_start_time "$daemon_pid")" = "$daemon_start" ] || return 0
  [ "$(process_start_time "$updater_pid")" = "$updater_start" ] || return 0

  updater_exe="$(readlink -f "/proc/$updater_pid/exe" 2>/dev/null || true)"
  case "$updater_exe" in
    "$HOME/.codex/packages/standalone/"*/bin/codex) ;;
    *) return 0 ;;
  esac

  mapfile -d '' -t updater_argv < "/proc/$updater_pid/cmdline"
  [ "${#updater_argv[@]}" -eq 4 ] || return 0
  [ "${updater_argv[1]}" = app-server ] || return 0
  [ "${updater_argv[2]}" = daemon ] || return 0
  [ "${updater_argv[3]}" = pid-update-loop ] || return 0

  echo "codex: recovering unreaped app-server PID $daemon_pid by stopping daemon manager PID $updater_pid." >&2
  kill "$updater_pid"

  local attempt state
  for attempt in {1..50}; do
    [ ! -e "/proc/$updater_pid/status" ] && break
    state="$(process_status_value "$updater_pid" State)"
    [ "$state" = Z ] && break
    sleep 0.1
  done
  if [ -e "/proc/$updater_pid/status" ] && [ "$(process_status_value "$updater_pid" State)" != Z ]; then
    echo "codex: daemon manager PID $updater_pid did not stop after 5 seconds." >&2
    return 1
  fi
}

if daemon_lifecycle_command "$@"; then
  recover_unreaped_daemon
fi

key="$(active_account_key || true)"
if [ -n "$key" ]; then
  if [ ! -f "$STAMP" ]; then
    # First run on this machine. A missing stamp is not evidence of a switch, so
    # adopt the current account rather than restarting a daemon that is probably
    # already serving it. Switches from here on are detected normally.
    printf '%s' "$key" > "$STAMP"
    exec "$CODEX_BIN" "$@"
  fi

  prev="$(cat "$STAMP" 2>/dev/null || true)"

  if [ "$key" != "$prev" ]; then
    if daemon_running; then
      if [ "${CODEX_NO_AUTO_RESTART:-0}" = 1 ]; then
        echo "codex: active account changed; the running app-server still serves the old one." >&2
        echo "codex: run 'codex app-server daemon restart' to pick it up." >&2
      else
        echo "codex: active account changed — restarting app-server to pick it up." >&2
        "$CODEX_BIN" app-server daemon restart >/dev/null 2>&1 || true
        printf '%s' "$key" > "$STAMP"
      fi
    else
      # No daemon yet, so whatever starts next reads the current account.
      printf '%s' "$key" > "$STAMP"
    fi
  fi
fi

exec "$CODEX_BIN" "$@"
